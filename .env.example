# ===== 域名与 HTTPS（Docker 部署必填）=====
# 已解析到本服务器 IP 的域名，Caddy 会自动申请并续期证书
DOMAIN=bot.example.com
# 证书到期提醒、Let's Encrypt 账号用的邮箱
ACME_EMAIL=you@example.com

# ===== Telegram 机器人 =====
# 可以留空，部署后在 Web 后台的“设置”里填写（网页里填写的优先）
BOT_TOKEN=

# ===== Web 后台 =====
# 登录用的访问令牌，至少 16 个字符。留空则首次启动时自动生成并打印在日志里（只显示一次）
WEB_ADMIN_TOKEN=
# 不用 Docker 时：Web 只监听本机，由 Caddy 反向代理
WEB_HOST=127.0.0.1
WEB_PORT=8080
# 只有在反向代理之后才设为 1（Docker 部署已自动设置）
TRUST_PROXY=0

# ===== 检查频率（也可在 Web 后台修改）=====
# 默认检查间隔（秒），可任意设置，最少 5 秒；单个网址可在网页上单独设置
CHECK_INTERVAL=60
NOTIFY_COOLDOWN=120
FAIL_ALERT_THRESHOLD=5

# ===== 抓取（修改后重启生效）=====
CONCURRENCY=5
HOST_MIN_GAP=3
REQUEST_TIMEOUT=20
# 可选：抓取用的代理，例如 http://127.0.0.1:7890，也可以是节点分享链接（anytls / vless / vmess / trojan / ss / hysteria2 / tuic）（建议在网页“设置 → 抓取代理”填写，网页上的设置优先）
# 这里设置时对所有网址生效；在网页上可以改为只用于开启了“通过代理读取”的网址
FETCH_PROXY=
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0 Safari/537.36

# ===== 版本更新（网页一键更新）=====
UPDATE_REPO=Soulleslie/vps-monitor-bot
UPDATE_BRANCH=main

# ===== 其他 =====
DB_PATH=data/bot.db
TZ=Asia/Shanghai
LOG_LEVEL=INFO
