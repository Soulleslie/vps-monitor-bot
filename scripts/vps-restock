#!/usr/bin/env bash
# VPS 补货监控 —— 管理命令（由 install.sh 安装到 /usr/local/bin/vps-restock）
set -Eeuo pipefail

INSTALL_DIR="${INSTALL_DIR:-/opt/vps-restock-bot}"
RUN_DIR="$INSTALL_DIR/run"
BRANCH="${BRANCH:-main}"
CONTAINER_UID=10001
UNIT_PATH=/etc/systemd/system/vps-restock-update.path
UNIT_SERVICE=/etc/systemd/system/vps-restock-update.service

if [ -t 1 ]; then C_GRN=$'\033[32m'; C_YLW=$'\033[33m'; C_RED=$'\033[31m'; C_BLD=$'\033[1m'; C_RST=$'\033[0m'
else C_GRN=""; C_YLW=""; C_RED=""; C_BLD=""; C_RST=""; fi
die() { printf '%s✘ %s%s\n' "$C_RED" "$*" "$C_RST" >&2; exit 1; }
ok()  { printf '%s✔ %s%s\n' "$C_GRN" "$*" "$C_RST"; }

# 临时文件统一用 vps-restock. 前缀；无论成功、失败还是 Ctrl+C 中断，退出时都会删除
TMP_PATHS=()
new_tmp() {  # new_tmp [-d]：创建临时文件/目录，路径存入 REPLY
  REPLY="$(mktemp "$@" "${TMPDIR:-/tmp}/vps-restock.XXXXXXXX")"
  TMP_PATHS+=("$REPLY")
}
cleanup_tmp() {
  local p
  for p in "${TMP_PATHS[@]:-}"; do
    [ -n "$p" ] && rm -rf -- "$p"
  done
  return 0
}
trap cleanup_tmp EXIT
trap 'exit 130' INT TERM

usage() {
  cat <<EOF
用法：vps-restock <命令>

  status          运行状态、版本、访问地址、证书到期时间
  logs [bot|caddy]
                  查看实时日志（默认 bot，Ctrl+C 退出）
  restart         重启
  update          更新到最新版本并重启（保留数据和配置）
  reset-token     重新生成网页访问令牌（旧令牌立即失效）
  backup          备份数据库和配置到 /root
  uninstall       卸载并还原到安装前的状态（--keep-backup 保留备份）
EOF
}

[ "$(id -u)" -eq 0 ] || die "请使用 root 运行"
[ -f "$INSTALL_DIR/docker-compose.yml" ] || die "未找到安装目录 $INSTALL_DIR"
cd "$INSTALL_DIR"

env_get() { awk -v k="$1" 'index($0, k "=") == 1 { sub(/^[^=]*=/, ""); print; exit }' .env 2>/dev/null || true; }
DOMAIN="$(env_get DOMAIN)"

# ---------------------------------------------------------------- 与容器共享的状态文件
json_str() { printf '%s' "$1" | tr -d '\000-\037' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
write_file() {  # 原子写入，避免容器读到半个文件
  local target="$1" tmp
  tmp="$(mktemp "$RUN_DIR/.tmp.XXXXXX")"
  cat >"$tmp"
  chmod 644 "$tmp"
  mv -f "$tmp" "$target"
}
prepare_run_dir() {
  mkdir -p "$RUN_DIR"
  chown "$CONTAINER_UID:$CONTAINER_UID" "$RUN_DIR"
  chmod 750 "$RUN_DIR"
}
write_version() {
  local subj
  subj="$(git log -1 --format=%s)"
  printf '{"commit":"%s","date":"%s","subject":"%s"}\n' \
    "$(git rev-parse HEAD)" "$(git log -1 --format=%cI)" "$(json_str "$subj")" | write_file "$RUN_DIR/version.json"
}
write_status() {  # state message from to started finished
  printf '{"state":"%s","message":"%s","from":"%s","to":"%s","started":%s,"finished":%s}\n' \
    "$1" "$(json_str "$2")" "$3" "$4" "${5:-null}" "${6:-null}" | write_file "$RUN_DIR/update-status.json"
}

# ---------------------------------------------------------------- 网页一键更新的 systemd 单元
cmd_install_units() {
  prepare_run_dir
  cat >"$UNIT_SERVICE" <<EOF
[Unit]
Description=VPS restock bot: update requested from web panel

[Service]
Type=oneshot
ExecStartPre=/bin/rm -f $RUN_DIR/update-request
ExecStart=/usr/local/bin/vps-restock update --from-web
TimeoutStartSec=1800
EOF
  cat >"$UNIT_PATH" <<EOF
[Unit]
Description=VPS restock bot: watch for web update requests

[Path]
PathExists=$RUN_DIR/update-request
Unit=vps-restock-update.service

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable --now vps-restock-update.path >/dev/null 2>&1
  printf '{"enabled":true}\n' | write_file "$RUN_DIR/updater.json"
  write_version
}

# ---------------------------------------------------------------- 更新
cmd_update() {
  local started before after log
  [ "${1:-}" = "--from-web" ] && echo "由网页后台发起的更新"
  prepare_run_dir
  rm -f "$RUN_DIR/update-request"
  started="$(date +%s)"
  before="$(git rev-parse --short HEAD)"
  log="$RUN_DIR/update.log"
  : >"$log"; chmod 644 "$log"
  write_status running "正在下载新版本" "$before" "" "$started"

  if ! git fetch --depth 1 origin "$BRANCH" >>"$log" 2>&1; then
    write_status failed "下载失败，请检查服务器能否访问 GitHub" "$before" "" "$started" "$(date +%s)"
    die "下载失败，详见 $log"
  fi
  after="$(git rev-parse --short "origin/$BRANCH")"
  if [ "$after" = "$before" ]; then
    write_status success "已是最新版本" "$before" "$after" "$started" "$(date +%s)"
    ok "已是最新版本 $after"
    return 0
  fi
  git reset --hard "origin/$BRANCH" -q
  write_status running "正在构建并重启（约 1～3 分钟，期间网页会短暂无法访问）" "$before" "$after" "$started"
  if ! docker compose up -d --build --remove-orphans >>"$log" 2>&1; then
    write_status failed "构建或启动失败，请查看更新日志" "$before" "$after" "$started" "$(date +%s)"
    die "构建失败，详见 $log"
  fi
  install -m 755 scripts/vps-restock /usr/local/bin/vps-restock
  cmd_install_units                     # 单元定义可能随版本更新
  write_status success "已更新到 $after" "$before" "$after" "$started" "$(date +%s)"
  ok "已更新 $before → $after"
}

# ---------------------------------------------------------------- 其他命令
cmd_status() {
  printf '%s版本%s      %s\n' "$C_BLD" "$C_RST" "$(git log -1 --format='%h  %cd  %s' --date=format:'%Y-%m-%d %H:%M' 2>/dev/null || echo 未知)"
  printf '%s地址%s      https://%s\n' "$C_BLD" "$C_RST" "$DOMAIN"
  printf '%s网页更新%s  %s\n\n' "$C_BLD" "$C_RST" "$(systemctl is-active vps-restock-update.path 2>/dev/null || echo 未启用)"
  docker compose ps
  local health end days
  health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' vps-restock-bot 2>/dev/null || echo 未运行)"
  printf '\n%s程序状态%s  %s\n' "$C_BLD" "$C_RST" "$health"
  end="$(echo | timeout 8 openssl s_client -servername "$DOMAIN" -connect "$DOMAIN:443" 2>/dev/null \
          | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2 || true)"
  if [ -n "$end" ]; then
    days=$(( ($(date -d "$end" +%s) - $(date +%s)) / 86400 ))
    if [ "$days" -lt 20 ]; then
      printf '%s证书到期%s  %s（剩余 %s 天）%s ← 正常应在到期前 30 天自动续期，请查看 vps-restock logs caddy%s\n' \
        "$C_BLD" "$C_RST" "$end" "$days" "$C_YLW" "$C_RST"
    else
      printf '%s证书到期%s  %s（剩余 %s 天，%s自动续期%s）\n' "$C_BLD" "$C_RST" "$end" "$days" "$C_GRN" "$C_RST"
    fi
  else
    printf '%s证书%s      %s无法获取，请检查 vps-restock logs caddy%s\n' "$C_BLD" "$C_RST" "$C_YLW" "$C_RST"
  fi
}

cmd_backup() {
  local ts work backup
  ts="$(date +%Y%m%d-%H%M%S)"; backup="/root/vps-restock-backup-$ts.tar.gz"
  new_tmp -d; work="$REPLY"   # 含数据库和 .env，退出时（包括失败、中断）一定会被删除
  # 用 SQLite 在线备份接口导出一致的快照，不需要停机
  docker compose exec -T bot python -c "
import sqlite3; src = sqlite3.connect('/app/data/bot.db'); dst = sqlite3.connect('/tmp/backup.db')
src.backup(dst); dst.close(); src.close()" || die "备份数据库失败"
  mkdir -p "$work/data"
  docker compose cp bot:/tmp/backup.db "$work/data/bot.db" >/dev/null
  docker compose exec -T bot rm -f /tmp/backup.db || true
  cp -p .env "$work/env"
  tar -czf "$backup" -C "$work" . && chmod 600 "$backup"
  rm -rf -- "$work"
  ok "已备份到 $backup"
}

case "${1:-}" in
  update)
    # 更新会改写本脚本文件；先复制到临时位置再执行，避免执行中途读到新内容
    if [ -z "${VRB_REEXEC:-}" ]; then
      tmp="$(mktemp "${TMPDIR:-/tmp}/vps-restock.XXXXXXXX")"; cp "$0" "$tmp"
      VRB_REEXEC="$tmp" exec bash "$tmp" "$@"
    fi
    TMP_PATHS+=("$VRB_REEXEC")   # 由新进程负责删除这份临时副本
    cmd_update "${2:-}"
    ;;
  status) cmd_status ;;
  logs) docker compose logs -f --tail 100 "${2:-bot}" ;;
  restart) docker compose restart && ok "已重启" ;;
  reset-token)
    out="$(docker compose exec -T bot python -m bot reset-web-token)" || die "重置失败"
    docker compose restart bot >/dev/null   # 让运行中的程序加载新令牌
    printf '%s\n' "$out"; ok "程序已重启，新令牌已生效"
    ;;
  backup) cmd_backup ;;
  install-units) cmd_install_units && ok "已启用网页一键更新" ;;
  uninstall)
    # 复制到临时位置再运行，因为卸载会删除安装目录本身
    new_tmp; tmp="$REPLY"; cp scripts/uninstall.sh "$tmp"
    rc=0; INSTALL_DIR="$INSTALL_DIR" bash "$tmp" "${@:2}" || rc=$?
    exit $rc   # 退出时自动删除临时副本
    ;;
  -h|--help|help|"") usage ;;
  *) usage; die "未知命令：$1" ;;
esac
